<section class="tab items {{tabs.items.cssClass}}" data-group="{{tabs.items.group}}" data-tab="{{tabs.items.id}}">

  {{#if (eq actor.type "character")}}
    <section class="resources grid grid-5col">

      <div class="resource flex-group-center">
        <label for="system.money.pp.value" class="resource-label">{{localize data.money.pp.label}}</label>
        <div class="resource-content flexrow flex-center flex-between">
          <input type="number" name="system.money.pp.value" value="{{data.money.pp.value}}" data-dtype="Number" />
        </div>
      </div>

      <div class="resource flex-group-center">
        <label for="system.money.gp.value" class="resource-label">{{localize data.money.gp.label}}</label>
        <div class="resource-content flexrow flex-center flex-between">
          <input type="number" name="system.money.gp.value" value="{{data.money.gp.value}}" data-dtype="Number" />
        </div>
      </div>

      <div class="resource flex-group-center">
        <label for="system.money.ep.value" class="resource-label">{{localize data.money.ep.label}}</label>
        <div class="resource-content flexrow flex-center flex-between">
          <input type="number" name="system.money.ep.value" value="{{data.money.ep.value}}" data-dtype="Number" />
        </div>
      </div>

      <div class="resource flex-group-center">
        <label for="system.money.sp.value" class="resource-label">{{localize data.money.sp.label}}</label>
        <div class="resource-content flexrow flex-center flex-between">
          <input type="number" name="system.money.sp.value" value="{{data.money.sp.value}}" data-dtype="Number" />
        </div>
      </div>

      <div class="resource flex-group-center">
        <label for="system.money.cp.value" class="resource-label">{{localize data.money.cp.label}}</label>
        <div class="resource-content flexrow flex-center flex-between">
          <input type="number" name="system.money.cp.value" value="{{data.money.cp.value}}" data-dtype="Number" />
        </div>
      </div>

    </section>
  {{/if}}

  {{> "systems/basicfantasyrpg/templates/actor/parts/items-list.hbs"}}
</section>