<div class="grid grid-3col ">
  <div class="resource flex-group-left">
    <label class="resource-label">{{localize data.price.label}}</label>
    <div class="flexrow">
      <input type="number" name="system.price.amount" value="{{data.price.amount}}" data-dtype="Number" min="0" class="price-value"/>
      <select name="system.price.currency" data-dtype="String" class="price-currency">
        {{selectOptions moneyAbbr selected=data.price.currency localize=true}}
      </select>
    </div>
  </div>
  <div class="resource flex-group-left">
    <label for="system.weight.value" class="resource-label">{{localize data.weight.label}}</label>
    <input type="text" name="system.weight.value" value="{{data.weight.value}}" data-dtype="Number" />
  </div>
  <div class="resource flex-group-left">
    <label for="system.armorClass.value" class="resource-label">{{localize data.armorClass.abbr}}</label>
    <input type="text" name="system.armorClass.value" value="{{data.armorClass.value}}" data-dtype="Number" />
  </div>
</div>