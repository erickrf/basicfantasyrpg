<div class="{{item.type}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" title="{{item.name}}"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'BASICFANTASYRPG.Name'}}"/></h1>

      {{> (concat "systems/basicfantasyrpg/templates/item/" item.type ".hbs")}}

    </div>
  </header>
</div>
