<div class="grid grid-3col">
  <div class="resource">
    <label class="resource-label">{{localize data.price.label}}</label>
    <div class="flexrow">
      <input type="number" class="price-value" name="system.price.amount" value="{{data.price.amount}}" data-dtype="Number" min="0" />
      <select name="system.price.currency" data-dtype="String" class="price-currency" >
        {{selectOptions moneyAbbr selected=data.price.currency localize=true}}
      </select>
    </div>
  </div>
  <div class="resource">
    <label for="system.size.value" class="resource-label">{{localize data.size.label}}</label>
    <select name="system.size.value" data-dtype="String">
      {{selectOptions weaponSizes selected=data.size.value localize=true}}
    </select>
  </div>
  <div class="resource">
    <label for="system.weight.value" class="resource-label">{{localize data.weight.label}}</label>
    <input type="text" name="system.weight.value" value="{{data.weight.value}}" data-dtype="String" />
  </div>
  <div class="resource">
    <label for="system.damage.value" class="resource-label">{{localize data.damage.label}}</label>
    <input type="text" name="system.damage.value" value="{{data.damage.value}}" data-dtype="String" />
  </div>
  <div class="resource">
    <label for="system.bonusAb.value" class="resource-label">{{localize data.bonusAb.label}}</label>
    <input type="text" name="system.bonusAb.value" value="{{data.bonusAb.value}}" data-dtype="Number" />
  </div>
  <div class="resource">
    <label for="system.range.value" class="resource-label">{{localize data.range.label}}</label>
    <input type="text" name="system.range.value" value="{{data.range.value}}" data-dtype="String" />
  </div>
</div>

<div class="grid grid-3col">
  <div class="resource">
    <label for="system.melee.value" class="resource-label">{{localize data.melee.label}}</label>
    <input type="checkbox" name="system.melee.value" {{checked data.melee.value}} data-dtype="Boolean" />
  </div>
</div>